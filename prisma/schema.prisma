// UpSycle — Prisma schema
// Postgres (Amazon RDS) via Prisma ORM, per tech-stack-recommendation.md
//
// Scope: Phase 0 (issue #4) + Phase 1 field-level detail from mvp-build-plan.md.
// Deliberately NOT modeled (Phase 2 backlog, do not block adding later):
//   - subscription tiers (seller featured-placement ranking)
//   - private buyer<->seller messaging (public product Q&A is modeled below —
//     ProductQuestion — but a private DM channel is a separate, deferred scope)
//   - buyer reviews on purchased items
//   - "recommended items" personalization state
//   - admin analytics dashboard aggregates (derivable from Order/Product/User via queries)
//
// Auth: Amazon Cognito owns credentials (passwords, OTP/password-reset flow, sessions).
// This schema stores only a Cognito user id (`cognitoSub`) on User — no password field.

generator client {
  provider = "prisma-client-js"
  // "native" covers the App Runner Docker build (infra/lib/stacks/apprunner-stack.ts
  // + Dockerfile: `prisma generate` runs inside the same build stage/base image the
  // app actually runs in, so no cross-platform mismatch there — see git history for
  // the Amplify-era saga that originally needed an explicit rhel-openssl-3.0.x
  // target, removed once Amplify was dropped).
  //
  // "rhel-openssl-3.0.x" came back for a different reason: the weekly placement
  // Lambda (infra/lib/stacks/placement-stack.ts) runs on Amazon Linux 2023
  // (glibc, OpenSSL 3.0), not this dev machine, and NodejsFunction bundling copies
  // the generated client's engine binary as-is rather than rebuilding it — see
  // infra/lambda/placement/copy-prisma-engine.js. `prisma generate` must be run on
  // (or cross-generate for) a Lambda-compatible platform before `cdk deploy
  // UpSycle-PlacementStack` is run for real, or the Lambda will ship whichever
  // engine the generating machine happens to be (e.g. a Windows binary from a local
  // dev box), which crashes at runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & roles
// ---------------------------------------------------------------------------

// Multi-role design rationale:
// Requirement.MD is explicit that "user can hold multiple roles" (buyer/seller/admin
// simultaneously). Modeling role as a single enum field on User would make holding
// more than one role impossible (or require hacky combined enum values like
// "BUYER_SELLER"). Instead we use a join table (UserRole) between User and a Role
// enum, giving each user zero-to-many roles. SellerProfile is a separate 1:1 table
// (not folded into User) because it only exists/is populated once a user takes on
// the seller role and goes through vetting — keeping it separate avoids a wide User
// table full of nullable seller-only columns and lets us attach an approval
// workflow (pending/approved/suspended) that has no meaning for pure buyers.
model User {
  id         String   @id @default(uuid())
  cognitoSub String   @unique // Cognito user pool "sub" — Cognito owns credentials
  email      String   @unique
  firstName  String?
  lastName   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  roles         UserRole[]
  addresses     Address[]
  sellerProfile SellerProfile?
  orders        Order[]        @relation("BuyerOrders")

  referralsSent     SellerReferral[] @relation("ReferrerUser")
  referralsReceived SellerReferral[] @relation("ReferralUser")

  questionsAsked    ProductQuestion[] @relation("QuestionAsker")
  questionsAnswered ProductQuestion[] @relation("QuestionAnswerer")
  pendingCheckouts  PendingCheckout[]

  @@map("users")
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

// Join table giving each User zero-to-many Roles (see rationale above).
model UserRole {
  id     String @id @default(uuid())
  userId String
  role   Role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Seller vetting
// ---------------------------------------------------------------------------

enum SellerApprovalStatus {
  PENDING
  APPROVED
  SUSPENDED
}

// Paid subscription tier a seller applies under / can change from their
// dashboard. See TierPlan below for the actual pricing/benefit data this
// value keys into.
enum SellerTier {
  TIER_1
  TIER_2
  TIER_3
}

// Data-driven per-tier pricing/benefit config, one row per SellerTier value.
// Deliberately NOT hardcoded as enum-branching logic anywhere in app code —
// every tier-gated behavior (billing price, benefit copy, search rank boost)
// reads these columns, so pricing/benefits can be corrected later (Prisma
// Studio, a raw UPDATE, or a future admin editor) with zero redeploy.
// Tier 2/3 ship with all benefit fields zeroed/null and isPricingFinalized =
// false because Prompts/Tier_system.md never defines them — code that
// presents tier benefits/pricing as final (seller portal copy, search
// ranking weight) must check isPricingFinalized rather than assume these
// placeholder zeros are real product decisions.
model TierPlan {
  id                        String     @id @default(uuid())
  tier                      SellerTier @unique
  name                      String
  monthlyPriceCents         Int        @default(0) // 0 = free tier (valid — Tier_system.md never finishes the billing-trigger sentence, so a $0 tier is a legitimate outcome, not a bug)
  quarterlySalesTargetCents Int? // null = no target defined yet (Tier 2/3)
  lotteryEntriesPerPeriod   Int        @default(0)
  socialPostsPerPeriod      Int        @default(0)
  benefitPeriodDays         Int        @default(30) // assumed monthly cadence — spec never states one
  canHighlightProducts      Boolean    @default(false)
  searchRankWeight          Int        @default(0) // mirrored onto SellerProfile.searchRankWeight for /browse ordering — see that field's comment
  isPricingFinalized        Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions SellerSubscription[]
  tierChanges   SellerTierChange[]

  @@map("tier_plans")
}

enum SellerSubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  COMPED // admin-granted or demo — no Stripe subscription, listings stay public
}

// The real, billing-aware record behind a seller's tier — one per
// SellerProfile. SellerProfile.tier/searchRankWeight remain denormalized read
// caches (see those fields) kept in sync from here inside the same
// transaction as every write (see lib/seller-billing.ts), so the cache can
// never drift from this source of truth.
model SellerSubscription {
  id                     String                   @id @default(uuid())
  sellerProfileId        String                   @unique
  tierPlanId             String
  status                 SellerSubscriptionStatus @default(COMPED)
  stripeCustomerId       String?                  @unique
  stripeSubscriptionId   String?                  @unique
  stripePriceId          String?
  billingInterval        String?
  currentPeriodEnd       DateTime?
  trialEnd               DateTime?
  cancelAtPeriodEnd      Boolean                  @default(false)
  // Reporting flag copied from Stripe subscription metadata founding_artist=true.
  // Not a price lock. Founders switch plans at the current prices, like everyone else.
  foundingArtist         Boolean                  @default(false)
  // True once the 9-month 50% coupon is scheduled to start after the free months.
  foundingCouponScheduled Boolean                 @default(false)
  // When a past-due, unpaid, or canceled subscription entered that state.
  // Listings stay up until this plus the grace period.
  delinquentSince        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  tierPlan      TierPlan      @relation(fields: [tierPlanId], references: [id], onDelete: Restrict)

  @@map("seller_subscriptions")
}

enum FoundingOfferStatus {
  PENDING
  CONFIRMED
  RELEASED
}

// One row per seller who has been offered a Founding Artist slot. The cap is
// 50 pending-or-confirmed rows. Released rows (abandoned checkout) free a slot.
model FoundingOfferClaim {
  id                      String              @id @default(uuid())
  sellerProfileId         String              @unique
  stripeCheckoutSessionId String?             @unique
  status                  FoundingOfferStatus @default(PENDING)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("founding_offer_claims")
}

// Stripe event ids we have already applied. A retried webhook hits this unique
// id and does not write the seller again.
model ProcessedStripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())

  @@map("processed_stripe_events")
}

enum TierChangeReason {
  SELLER_CHECKOUT // seller subscribed/changed tier themselves via Stripe Checkout
  STRIPE_SYNC // webhook-driven change (portal upgrade/downgrade/cancel)
  ADMIN_OVERRIDE // admin comp, no Stripe involved
  SEED_BACKFILL // demo-data / migration backfill row
}

// Append-only audit trail of every tier transition, however it happened.
model SellerTierChange {
  id              String           @id @default(uuid())
  sellerProfileId String
  fromTier        SellerTier?
  toTier          SellerTier
  reason          TierChangeReason
  changedByUserId String? // admin User.id for ADMIN_OVERRIDE; null for STRIPE_SYNC/SEED_BACKFILL
  stripeEventId   String?          @unique // dedupes webhook retries; Postgres allows multiple NULLs in a unique index
  note            String? // admin override reason, or null
  createdAt       DateTime         @default(now())

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  tierPlan      TierPlan      @relation(fields: [toTier], references: [tier], onDelete: Restrict)

  @@map("seller_tier_changes")
}

model SellerProfile {
  id     String @id @default(uuid())
  userId String @unique

  // Readable storefront URL segment (/sellers/[slug]) — generated once at
  // application time from the applicant's name/email (see lib/slug.ts) since
  // a raw SellerProfile.id guid isn't something a seller can share with
  // customers. Immutable after creation to avoid breaking links a seller has
  // already shared.
  slug String @unique

  // Paragraph the seller writes about themselves/their shop. Collected at
  // application time but editable afterward from the seller dashboard
  // (app/(seller)/sell/profile) — unlike the rest of SellerProfile's
  // application-vetting fields, this is customer-facing copy shown on the
  // seller's storefront page, so it's expected to be kept up to date.
  story String?

  websiteUrl           String?
  socialMediaUrls      String[] // multiple social accounts allowed
  expectedMonthlySales Int? // expected volume of sales per month
  supplierList         String[] // e.g. "Home Depot", "Hobby Lobby"
  approvalStatus       SellerApprovalStatus @default(PENDING)
  // Plan the applicant asked for. Not the billed tier. Checkout and webhooks
  // never read this to decide what to charge.
  requestedTier        SellerTier?
  // Admin-only eligibility for the Founding Artist offer. The seller cannot
  // set this. Checkout also accepts the FOUNDING50 code, capped at 50 sellers.
  foundingOffer        Boolean              @default(false)
  // Denormalized read cache of the billed tier. Webhooks are the only writer
  // after signup (seed data is the other). A seller cannot set this from the
  // dashboard or the application form.
  tier                 SellerTier           @default(TIER_1)
  // Denormalized copy of TierPlan.searchRankWeight for the seller's current
  // tier — lets /browse's Product query sort with a single 1-level relation
  // orderBy (sellerProfile.searchRankWeight) instead of a 2-level join
  // through SellerSubscription -> TierPlan on every listing request. Synced
  // by the same applyTierChange helper as `tier` above.
  searchRankWeight     Int                  @default(0)

  // Ship-from address used for calculated labels. The street is not shown
  // on the public shop page.
  shipFromName       String?
  shipFromLine1      String?
  shipFromLine2      String?
  shipFromCity       String?
  shipFromState      String?
  shipFromPostalCode String?
  shipFromCountry    String  @default("US")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  samplePhotos  SellerSamplePhoto[]
  products      Product[]
  orderItems    OrderItem[]
  subscription   SellerSubscription?
  foundingClaim  FoundingOfferClaim?
  tierChanges    SellerTierChange[]
  lotteryWins   LotteryWinner[]
  slotPurchases FeaturedSlotPurchase[]
  shipments     Shipment[]
  freightRequests ShippingQuoteRequest[]

  @@map("seller_profiles")
}

// The 5 required sample product photos submitted at seller signup for vetting.
model SellerSamplePhoto {
  id              String   @id @default(uuid())
  sellerProfileId String
  url             String // S3 object URL/key
  createdAt       DateTime @default(now())

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@map("seller_sample_photos")
}

// Referral tracking: an existing seller (referrer) refers a new artisan (referral).
// Kept minimal for Phase 0/1 (linkage only) — invite-email generation is Phase 2 #4.
model SellerReferral {
  id            String   @id @default(uuid())
  referrerId    String // existing seller's User.id
  referralId    String?  @unique // new artisan's User.id once they sign up (nullable until claimed)
  referralEmail String // email the invite was addressed to
  createdAt     DateTime @default(now())

  referrer User  @relation("ReferrerUser", fields: [referrerId], references: [id], onDelete: Cascade)
  referral User? @relation("ReferralUser", fields: [referralId], references: [id], onDelete: SetNull)

  @@map("seller_referrals")
}

// ---------------------------------------------------------------------------
// Addresses
// ---------------------------------------------------------------------------

model Address {
  id         String  @id @default(uuid())
  userId     String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String  @default("US")
  isDefault  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ordersShipped Order[] @relation("ShippingAddress")

  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Categories (self-referential tree)
// ---------------------------------------------------------------------------

// Matches: Jewelry>{necklace,earring,bracelet,other},
// Home Goods>{woodworking,glassblowing,pottery,other}, Furniture>{dresser,table,chair,other}.
// Self-referential parent/children keeps the tree data-driven (seeded) rather than
// hardcoded, so future top-level categories or subcategories don't require a schema change.
model Category {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  parentId String?

  parent         Category?              @relation("CategoryToSubcategory", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[]             @relation("CategoryToSubcategory")
  products       Product[]
  lotteryWinners LotteryWinner[]
  slotPurchases  FeaturedSlotPurchase[]

  @@map("categories")
}

// ---------------------------------------------------------------------------
// Products
// ---------------------------------------------------------------------------

model Product {
  id              String @id @default(uuid())
  sellerProfileId String
  categoryId      String

  title             String
  description       String
  priceCents        Int // price of item, stored as integer cents
  shippingCostCents Int
  offersLocalPickup Boolean @default(false) // seller opt-in; buyer's approximate location shown is the seller's default Address city/state, never a full street address
  dimensions        String? // free-form e.g. "10x8x4 in" — kept in sync with the parcel fields
  weightGrams       Int?
  // Parcel used for live rates. Tenths of an inch and tenths of an ounce.
  // Empty means checkout falls back to shippingCostCents.
  packagePreset     String?
  parcelLengthTenths Int?
  parcelWidthTenths  Int?
  parcelHeightTenths Int?
  parcelWeightTenths Int?
  needsFreightQuote  Boolean @default(false)
  inventoryCount    Int     @default(0)

  // Seller-assigned display rank among their own listings (1 = highest
  // priority), used to order/place their products elsewhere on the site.
  // Dense and unique per seller (no ties, no gaps) — always a full 1..N
  // permutation of that seller's product count. Assigned on create (appended
  // to the end) and reassigned via lib/product-priority.ts's
  // reorderProductPriority whenever a seller changes it, which shifts every
  // product between the old and new rank by one to keep the sequence dense.
  marketingPriority Int

  proofOfHandcraftedUrl String // required proof-of-handcrafted upload (S3 key/URL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sellerProfile SellerProfile     @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  category      Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  photos          ProductPhoto[]
  orderItems      OrderItem[]
  questions       ProductQuestion[]
  freightRequests ShippingQuoteRequest[]

  @@unique([sellerProfileId, marketingPriority])
  @@map("products")
}

// 2-6 product photos per listing (count enforced at the application layer).
model ProductPhoto {
  id        String   @id @default(uuid())
  productId String
  url       String // S3 object URL/key
  position  Int      @default(0) // display order
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_photos")
}

// ---------------------------------------------------------------------------
// Product Q&A (public)
// ---------------------------------------------------------------------------

// Public buyer<->seller Q&A on a product page (Amazon/Etsy-style): a buyer
// asks, the product's seller answers, and both are visible to every visitor.
// Deliberately smaller in scope than private messaging (see header comment) —
// answer fields live inline on the question row rather than a separate
// Answer table, since a question has at most one seller-authored answer for
// this pass. Append-only from the buyer's side (no edit/delete) like
// ProductPhoto/OrderItem; a seller may re-answer (overwrite) to fix a typo.
model ProductQuestion {
  id           String    @id @default(uuid())
  productId    String
  askedById    String
  questionText String
  answerText   String?
  answeredById String?
  answeredAt   DateTime?
  createdAt    DateTime  @default(now())

  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  askedBy    User    @relation("QuestionAsker", fields: [askedById], references: [id], onDelete: Cascade)
  answeredBy User?   @relation("QuestionAnswerer", fields: [answeredById], references: [id], onDelete: SetNull)

  @@map("product_questions")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

enum ShippingStatus {
  PENDING_SHIPMENT
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  CANCELLED
}

enum ShippingCarrier {
  USPS
  UPS
  FEDEX
  DHL
}

// Per-line-item fulfillment choice made by the buyer at checkout (only
// offered when the Product has offersLocalPickup = true). Deliberately not
// folded into ShippingStatus — that enum tracks shipment progress, this
// tracks which fulfillment path was chosen at all; display layers relabel
// ShippingStatus values (e.g. "Ready for Pickup" instead of "Pending
// Shipment") based on this field rather than adding pickup-specific
// ShippingStatus values.
enum FulfillmentMethod {
  SHIP
  PICKUP
}

model Order {
  id                String  @id @default(uuid())
  buyerId           String
  shippingAddressId String? // nullable: an all-pickup order has no items to ship, so no address is collected

  // Whole-order convenience status (e.g. for a buyer's order-history list).
  // Authoritative shipment tracking is per-line-item (see OrderItem below),
  // since a single cart/order can span multiple sellers who ship
  // independently — this field is a derived/display aggregate, not the
  // thing sellers update directly.
  shippingStatus   ShippingStatus @default(PENDING_SHIPMENT)
  totalAmountCents Int
  // Unique so a retried Stripe webhook cannot insert a second order for the
  // same charge. Nulls stay allowed (Postgres unique indexes permit them).
  stripePaymentId  String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyer           User        @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  shippingAddress Address?    @relation("ShippingAddress", fields: [shippingAddressId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  shipments       Shipment[]

  @@map("orders")
}

enum PendingCheckoutStatus {
  OPEN
  FULFILLED
  REFUNDED
}

// The buyer's validated cart, saved before Stripe Checkout starts. Session
// metadata stores only this id. Stripe metadata values are capped at 500
// characters, which is too small for a full cart and was the previous
// (truncated) source of truth for the webhook.
model PendingCheckout {
  id                  String                @id @default(uuid())
  buyerId             String
  shippingAddressId   String?
  totalAmountCents    Int
  linesJson           Json
  status              PendingCheckoutStatus @default(OPEN)
  stripePaymentId     String?               @unique
  // Cents that must be refunded for this charge (amount mismatch, or lines
  // that could not be fulfilled). refundedAmountCents tracks what Stripe
  // already accepted so a webhook retry finishes the refund without
  // decrementing stock again.
  refundDueCents      Int                   @default(0)
  refundedAmountCents Int                   @default(0)
  shipmentsJson       Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  buyer User @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([buyerId])
  @@map("pending_checkouts")
}

// Line item — links an Order to a Product (and denormalizes the seller for querying
// "products sold this month" / "pending shipment" per seller without joining through
// Product, which could later be edited/discontinued).
model OrderItem {
  id              String @id @default(uuid())
  orderId         String
  productId       String
  sellerProfileId String

  quantity          Int @default(1)
  unitPriceCents    Int // price at time of purchase (snapshot, independent of later Product edits)
  shippingCostCents Int // 0 when fulfillmentMethod is PICKUP

  fulfillmentMethod FulfillmentMethod @default(SHIP)

  // Per-line-item shipment tracking. A single Order can contain items from
  // multiple sellers, each of whom ships independently — so ship, deliver,
  // and cancel act here. Order.shippingStatus is rewritten from these lines.
  shippingStatus ShippingStatus @default(PENDING_SHIPMENT)
  // Set when a cancel refund is accepted by Stripe. A retry uses the same
  // idempotency key and then fills this in if the first attempt failed.
  refundedAmountCents Int     @default(0)
  stripeRefundId      String?

  // Carrier tracking. The public link works without a tracking account.
  // providerTrackerId is set only when EasyPost accepts the number.
  carrier           ShippingCarrier?
  trackingNumber    String?
  trackingUrl       String?
  trackingProvider  String?
  providerTrackerId String?
  shipmentId        String?

  createdAt DateTime @default(now())

  trackingEvents TrackingEvent[]
  shipment       Shipment?       @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  sellerProfile  SellerProfile  @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)

  @@index([providerTrackerId])
  @@index([carrier, trackingNumber])
  @@index([shipmentId])
  @@map("order_items")
}

// One parcel per seller on an order. The buyer pays buyerChargeCents.
// labelCostCents is the carrier rate. marginCents is the platform markup.
model Shipment {
  id                  String   @id @default(uuid())
  orderId             String
  sellerProfileId     String
  mode                String
  carrier             String?
  service             String?
  speed               String?
  easypostShipmentId  String?
  easypostRateId      String?
  labelCostCents      Int
  buyerShippingCents  Int
  insuranceCents      Int      @default(0)
  buyerChargeCents    Int
  marginCents         Int
  insured             Boolean  @default(false)
  trackingNumber      String?
  labelUrl            String?
  createdAt           DateTime @default(now())

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  items         OrderItem[]

  @@index([orderId])
  @@map("shipments")
}

// Live rates offered to one buyer for one seller. Expires quickly because
// EasyPost rate ids do not stay valid forever.
model ShippingQuote {
  id                 String   @id @default(uuid())
  buyerId            String
  sellerProfileId    String
  easypostShipmentId String
  ratesJson          Json
  merchandiseCents   Int
  createdAt          DateTime @default(now())
  expiresAt          DateTime

  @@index([buyerId, sellerProfileId])
  @@map("shipping_quotes")
}

model ShippingQuoteRequest {
  id              String   @id @default(uuid())
  productId       String
  sellerProfileId String
  buyerName       String
  buyerEmail      String
  postalCode      String
  message         String?
  createdAt       DateTime @default(now())

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@index([sellerProfileId])
  @@map("shipping_quote_requests")
}

// One row per provider webhook event. The provider event id is unique so a
// retry does not move the line or email the buyer again.
model TrackingEvent {
  id              String   @id @default(uuid())
  providerEventId String   @unique
  orderItemId     String?
  carrierStatus   String
  createdAt       DateTime @default(now())

  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@map("tracking_events")
}

// ---------------------------------------------------------------------------
// Weekly placement: Home/Category/Sub-Category featured lottery + paid slots
// ---------------------------------------------------------------------------
// Implements Prompts/product_layout.md's "lottery system": a weekly Lambda
// draws lottery winners (Saturday) into a PENDING PlacementPeriod, sellers may
// buy a paid slot for that period first-come-first-served from the moment of
// the draw, and a second Lambda run (Sunday 00:00) locks purchased slots,
// random-fills any unsold ones, and flips the period ACTIVE (archiving the
// previous one). The site only ever renders the current ACTIVE period's rows
// for Home/Category/Sub-Category pages — buyers never see rank/slot numbers,
// same rule as Product.marketingPriority above.
//
// Which product gets shown for a winning seller is NOT stored here — render
// time resolves it from Product.marketingPriority (the seller's #1-ranked
// product), except where a seller holds multiple simultaneous placements in
// the same period, in which case featuredProductId below pins the specific
// product the cascade rule (product_layout.md: Home > Sub-Category > Category
// > randomly-assigned paid slot) assigned them, set once by the Sunday
// finalize step. A seller-purchased (non-random-fill) paid slot always uses
// their #1 product and leaves featuredProductId null.

enum PlacementPageType {
  HOME
  CATEGORY
  SUBCATEGORY
}

enum PlacementPeriodStatus {
  PENDING // drawn Saturday, purchase window open, not live yet
  ACTIVE // currently live on the site
  ARCHIVED // superseded by a newer ACTIVE period
}

model PlacementPeriod {
  id       String                @id @default(uuid())
  startsAt DateTime // Sunday 00:00 this period goes/went live
  endsAt   DateTime // following Sunday 00:00
  // At most one PENDING row. A second Saturday draw reuses it. The partial
  // unique index placement_periods_one_pending enforces that in Postgres.
  status   PlacementPeriodStatus @default(PENDING)
  drawnAt  DateTime              @default(now())

  winners LotteryWinner[]
  slots   FeaturedSlotPurchase[]

  @@map("placement_periods")
}

// One lottery-winning seller for one page/category in one period. `rank` is
// draw order only (tie-break / cascade input), never shown to buyers.
model LotteryWinner {
  id                String            @id @default(uuid())
  periodId          String
  pageType          PlacementPageType
  categoryId        String? // null for HOME; a top-level Category.id for CATEGORY; a leaf Category.id for SUBCATEGORY
  sellerProfileId   String
  rank              Int
  featuredProductId String? // set by the Sunday finalize cascade when this seller holds >1 placement this period; null = use their #1 marketingPriority product
  createdAt         DateTime          @default(now())

  period        PlacementPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  sellerProfile SellerProfile   @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([periodId, pageType, categoryId, sellerProfileId])
  @@unique([periodId, pageType, categoryId, rank])
  @@index([periodId, pageType, categoryId])
  @@map("lottery_winners")
}

// One paid (or random-filled) slot for one page/category in one period.
// `slotNumber` is a dense 1..SLOT_COUNT draw position within
// (period, pageType, categoryId) — see lib/placement.ts for the slot-count
// constant and purchase/fill logic.
model FeaturedSlotPurchase {
  id                String            @id @default(uuid())
  periodId          String
  pageType          PlacementPageType
  categoryId        String? // null for HOME
  slotNumber        Int
  sellerProfileId   String
  priceCents        Int
  isRandomFill      Boolean           @default(false) // true = system auto-filled an unsold slot at Sunday finalize, not a real purchase
  featuredProductId String? // cascade-assigned product when isRandomFill and the seller holds other placements this period; null = use their #1 marketingPriority product
  stripePaymentId   String?           @unique // null when isRandomFill; unique so a retried webhook cannot insert two slots for one charge
  purchasedAt       DateTime          @default(now())

  period        PlacementPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  sellerProfile SellerProfile   @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([periodId, pageType, categoryId, slotNumber])
  @@index([periodId, pageType, categoryId])
  @@map("featured_slot_purchases")
}
