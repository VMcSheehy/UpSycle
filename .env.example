# Local Postgres connection string for Prisma.
# Copy this file to .env and fill in real values — .env is gitignored.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/upsycle?schema=public"

# Amazon Cognito User Pool — provisioned by the parallel CDK-infra branch.
# Auth (signup/login/OTP password reset) is handled entirely by Cognito; this
# app never stores or validates passwords itself. See lib/cognito.ts.
COGNITO_REGION="us-west-2"
COGNITO_USER_POOL_ID="us-west-2_XXXXXXXXX"
COGNITO_USER_POOL_CLIENT_ID="XXXXXXXXXXXXXXXXXXXXXXXXXX"

# Amazon S3 — seller sample-photo, product-photo, and proof-of-handcrafted
# uploads (bucket not deployed yet). All three use this same bucket under
# distinct key prefixes (see app/api/upload/route.ts). Used by lib/s3.ts.
# Falls back to COGNITO_REGION if unset.
AWS_REGION="us-west-2"
PHOTOS_BUCKET_NAME=""
# CloudFront domain fronting PHOTOS_BUCKET_NAME (see infra/lib/stacks/storage-stack.ts
# — the bucket itself blocks all public access, so uploaded photo URLs must
# point here, not at the bucket directly). e.g. "d2eskr6p8recpt.cloudfront.net"
PHOTOS_CDN_DOMAIN=""

# Public site origin used for Stripe success and cancel URLs. The checkout
# API does not trust the request Origin header.
SITE_URL="http://localhost:3000"

# Stripe seller subscriptions and buyer checkout. Use a test key locally
# (sk_test_ or a restricted rk_test_ key). Never commit a live key. A
# restricted key is safer than a secret key. See README for the permissions
# and the webhook URL.
STRIPE_SECRET_KEY="sk_test_XXXXXXXXXXXXXXXXXXXXXXXX"
STRIPE_PUBLISHABLE_KEY="pk_test_XXXXXXXXXXXXXXXXXXXXXXXX"
# Reserved for Stripe.js. Hosted Checkout and the Customer Portal do not load
# Stripe.js, so the app does not read this in the browser today.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_XXXXXXXXXXXXXXXXXXXXXXXX"
# Signing secret for the /api/webhooks/stripe endpoint (from the Stripe CLI
# in dev, or the Dashboard webhook config in production).
STRIPE_WEBHOOK_SECRET="whsec_XXXXXXXXXXXXXXXXXXXXXXXX"
# Days a past-due or canceled seller's listings stay public. Default 7.
BILLING_GRACE_DAYS="7"

# EasyPost tracks USPS, UPS, FedEx, and DHL numbers the seller already has.
# Leave both empty to keep the carrier tracking link without automatic updates.
# Create a webhook in the EasyPost account pointed at
# https://<your-site>/api/webhooks/tracking and paste its secret here.
EASYPOST_API_KEY=""
EASYPOST_WEBHOOK_SECRET=""
TRACKING_PROVIDER="easypost"

# From address for order emails. Leave empty locally to skip sending.
# Production uses the SES domain identity. Mail is not delivered until that
# identity is verified and SES production access is approved.
SES_FROM_EMAIL=""
